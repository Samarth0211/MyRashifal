[Unit]
Description=MyRashifal Next.js application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=myrashifal
Group=myrashifal
WorkingDirectory=/opt/myrashifal/current
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3100
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
